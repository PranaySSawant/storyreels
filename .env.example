# --- LLM (script writer) ---
LLM_PROVIDER=anthropic            # anthropic | groq
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Instagram (Instagram API with Instagram Login) ---
IG_USER_ID=1784xxxxxxxxxxxx
IG_ACCESS_TOKEN=IGAA...           # long-lived token; auto-refreshed weekly into data/ig_token.json
IG_API_HOST=graph.instagram.com   # use graph.facebook.com if you use a Facebook Page token instead
IG_API_VERSION=v25.0

# --- S3 (temporary public link for Instagram to fetch the video) ---
S3_BUCKET=my-storyreels-bucket
S3_PREFIX=storyreels
AWS_REGION=ap-south-1

# --- paths ---
DATA_DIR=/opt/storyreels/data
PIPER_VOICES_DIR=/opt/storyreels/voices
